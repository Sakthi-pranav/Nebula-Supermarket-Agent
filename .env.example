# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM Provider Configuration
# Supported providers: "openai", "gemini", "groq", "ollama", "custom"
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
# Optional base URL for OpenAI-compatible proxies / local models
LLM_BASE_URL=

# Store Info Configuration
STORE_NAME="Sharma General Supermarket"
STORE_ADDRESS="Shop 12, Main Market, Indiranagar, Bengaluru, KA - 560038"
STORE_PHONE="+91 98765 43210"
STORE_GSTIN="29ABCDE1234F1Z5"
DEFAULT_PAYMENT_MODE=UPI

# Database Path
DATABASE_URL=sqlite:///generated/supermarket.db
